# Public browser configuration. The publishable key is protected by RLS.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public site and analytics configuration.
PUBLIC_SITE_URL=
PUBLIC_GA4_MEASUREMENT_ID=

# Server-only values. Never expose or commit these values.
SUPABASE_SECRET_KEY=
SUPABASE_OWNER_USER_ID=

# Optional server-only Google Search Console OAuth values.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
