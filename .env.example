# Public browser configuration. These values are safe to expose in the frontend.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Public analytics configuration.
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_SITE_URL=https://your-domain.example

# Server-only values. Never put these in browser JavaScript or commit a real .env file.
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-local-or-host-secret-storage
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=replace-in-server-secret-storage
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=replace-in-server-secret-storage
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=replace-in-server-secret-storage
